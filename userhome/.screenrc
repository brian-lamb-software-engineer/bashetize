##
# a screen base file
#
# for version >4.2 use ~/.screen_layout, and save as default (use 
#   screen -RA to reattach) (alias 'srad sessionName')

# Load the master configuration first (.screen_layout)
source ~/etc/.screen_layout

# select a default layout to source to load after, by uncommenting 
#   either indy or multi, or any of your custom configs 

# This one seeems more compatible with screen v 5.0.2
source $HOME/etc/.screen_2col_direct

# created for verion 4.0.x or close to 4.2.x
#source $HOME/etc/.screen_many

# the following one needs updating, doesnt work fully yet
#source ~/etc/.screen_multi_direct

# finally, save the layout as default
layout save def

#for version <4.2 use old setup
#source $HOME/etc/.screen_indy
#source $HOME/etc/.screen_multi
