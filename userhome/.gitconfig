[core]
	autocrlf = input
    fileMode = false
    ignorecase = true
    #status = auto
    #diff = auto
    #branch = auto
    #grep = auto
[color]
	ui = true
[color "branch"]
    #current = green
    #michael wales style
    current = yellow reverse
    local = yellow
    remote = green
    plain = normal
[color "diff"]
    meta = yellow bold
    #frag = cyan
    #frag = magenta bold
    frag = blue
    #old = red
    old = red bold
    #new = green
    new = green bold
    plain = normal
    commit = yellow
    whitespace = normal red
[color "grep"]
    match = normal
[color "interactive"]
    prompt = normal
    header = normal
    help = normal
    error = normal
[color "status"]
    #added = red
    added = yellow
    #header = white normal dim
    #header =white
	changed = blue normal bold
    updated = green
    untracked = red
    nobranch = red
[credential]
    helper = store
[http]
	sslverify = false
[user]
	name = Your Name Here
  # personal email here (or company email if not using below conditions)
  email = myemail@personal.com

# company email goes on the included file below based on condition, 
#   if you commit to multiple repos and dont want to use your company
#   email on anythign except company property
[includeIf "hasconfig:remote.*.url:https://github.com/company-keyword*/**"]
  path = .gitconfig-company

[includeIf "hasconfig:remote.*.url:git@github.com:company-keyword*/**"]
  path = .gitconfig-company
